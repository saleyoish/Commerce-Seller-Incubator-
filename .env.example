# ============================================
# Live Commerce Platform - Environment Variables
# ============================================

# Supabase (Latest API - Publishable/Secret keys)
# Get these from: Project Settings → API in your Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...  # Client-side key
SUPABASE_SECRET_KEY=eyJhbGci...                   # Server-side only (keep secret!)

# Stripe (Latest SDK v15+)
# Get these from: Developers → API Keys in your Stripe Dashboard
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...  # Add webhook endpoint first, then copy this

# Resend (Email service) - Optional, Gmail is preferred
# Get this from: Settings → API Keys in your Resend Dashboard
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com  # Must be a verified domain in Resend

# Gmail (Email service via App Password)
# Use Gmail App Password for sending emails
# How to create: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=theabdulmuqeet@gmail.com
GMAIL_APP_PASSWORD=rkbylzdchkmwbzth  # 16-character app password

# Platform Configuration
PLATFORM_FEE_PERCENT=15
MIN_PAYOUT_THRESHOLD=100
ADMIN_EMAIL=admin@example.com  # This email will be set as initial admin

# ============================================
# M4: Content Automation - Video Processing
# ============================================

# Mux (Video processing)
# Get from: https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=your_token_id
MUX_TOKEN_SECRET=your_token_secret
MUX_WEBHOOK_SECRET=your_webhook_secret  # Create webhook in Mux dashboard

# AssemblyAI (Caption generation)
# Get from: https://www.assemblyai.com/app
ASSEMBLYAI_API_KEY=your_api_key

# YouTube API (OAuth for auto-posting)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Instagram/Facebook Graph API
# Get from: https://developers.facebook.com/apps
INSTAGRAM_APP_ID=your_app_id
INSTAGRAM_APP_SECRET=your_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/callback

# ============================================
# Live Streaming - Restream.io Integration
# ============================================

# Restream API Token
# Get from: https://restream.io/settings/api
RESTREAM_API_TOKEN=your_restream_api_token

# Restream Webhook Secret (for receiving stream status updates)
# Set up webhook at: https://restream.io/settings/webhooks
# Webhook URL: https://yourdomain.com/api/webhooks/restream
RESTREAM_WEBHOOK_SECRET=your_webhook_secret
